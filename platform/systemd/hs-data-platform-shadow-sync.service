[Unit]
Description=Atomically synchronize legacy Hearthstone databases into PostgreSQL
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/srv/hs-data-platform/scripts/run-scheduled-sync shadow
TimeoutStartSec=46min
KillMode=mixed
TimeoutStopSec=90s
Nice=10
PrivateTmp=false
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/hs-data-platform/shadow-sync.log
StandardError=append:/var/log/hs-data-platform/shadow-sync.log
