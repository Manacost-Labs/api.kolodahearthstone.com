[Unit]
Description=Import Hearthstone datasets and normalized statistics into PostgreSQL
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/srv/hs-data-platform/scripts/run-scheduled-sync import
TimeoutStartSec=36min
KillMode=mixed
TimeoutStopSec=90s
Nice=10
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/hs-data-platform/jobs.jsonl
StandardError=append:/var/log/hs-data-platform/jobs.jsonl
