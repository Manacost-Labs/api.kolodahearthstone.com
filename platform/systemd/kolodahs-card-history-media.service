[Unit]
Description=Archive observed card image bytes without changing card snapshots
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=koloda
Group=koloda
ExecStart=/opt/wiki-hs-parser/.venv/bin/python /srv/api-kolodahearthstone/panel/current/scripts/archive_card_history_media.py --apply --remote --newest --limit 20
ExecStart=/opt/wiki-hs-parser/.venv/bin/python /srv/api-kolodahearthstone/panel/current/scripts/archive_card_history_media.py --apply --remote --limit 50 --state /srv/api-kolodahearthstone/panel-data/var/card-history-media-state.json
ExecStart=/opt/wiki-hs-parser/.venv/bin/python /srv/api-kolodahearthstone/panel/current/scripts/archive_card_history_media.py --apply --remote --retry --limit 10
TimeoutStartSec=10min
Nice=10
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/api-kolodahearthstone/panel-data/uploads /srv/api-kolodahearthstone/panel-data/var

[Install]
WantedBy=multi-user.target
