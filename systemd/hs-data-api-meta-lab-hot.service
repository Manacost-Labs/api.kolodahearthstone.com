[Unit]
Description=Collect eight Meta Intelligence Lab hot slices (isolated datasets)
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.meta_intelligence hot
TimeoutStartSec=1h
