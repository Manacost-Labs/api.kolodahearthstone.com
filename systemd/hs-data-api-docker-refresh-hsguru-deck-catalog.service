[Unit]
Description=Refresh broad HSGuru deck catalogs through Scrape.do
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target hs-data-api-docker-refresh-hsguru-meta-matrix.service

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
# `docker compose run` outlives a stopped or timed-out unit; the container is
# named after the unit so stale ones are removed before start and after stop.
ExecStartPre=-/usr/bin/docker rm -f %N
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm --name %N api python /app/scripts/refresh-hsguru-deck-catalog.py
ExecStopPost=-/usr/bin/docker stop --time 20 %N
ExecStopPost=-/usr/bin/docker rm -f %N
TimeoutStartSec=4h
TimeoutStopSec=30s
