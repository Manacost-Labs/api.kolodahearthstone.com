[Unit]
Description=Refresh the HSReplay deck mulligan guide (mulligan v2) in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
# `docker compose run` outlives a stopped or timed-out unit; the container is
# named after the unit so stale ones are removed before start and after stop.
ExecStartPre=-/usr/bin/docker rm -f %N
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm --name %N api python -m app.cli refresh-hsreplay-mulligan --scheduled --schedule-id refresh-hsreplay-mulligan
ExecStopPost=-/usr/bin/docker stop --time 20 %N
ExecStopPost=-/usr/bin/docker rm -f %N
# The run stops taking slices after HS_HSREPLAY_MULLIGAN_DEADLINE_SECONDS
# (40 min); in-flight Scrape.do requests finish within their 60 s timeout.
TimeoutStartSec=50min
TimeoutStopSec=1min
