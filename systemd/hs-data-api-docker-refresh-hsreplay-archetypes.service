[Unit]
Description=Refresh HSReplay Standard archetype SQLite database in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target hs-data-api-docker-firecrawl-hsreplay-map.service

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
# `docker compose run` outlives a stopped or timed-out unit; the container is
# named after the unit so stale ones are removed before start and after stop.
ExecStartPre=-/usr/bin/docker rm -f %N
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm --name %N api python -m app.cli refresh-hsreplay-archetypes --scheduled --schedule-id refresh-hsreplay-archetypes
ExecStopPost=-/usr/bin/docker stop --time 20 %N
ExecStopPost=-/usr/bin/docker rm -f %N
