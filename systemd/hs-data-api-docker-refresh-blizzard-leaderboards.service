[Unit]
Description=Refresh the live seasons of the official Blizzard leaderboards in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.cli refresh-blizzard-leaderboards --scope live --scheduled --schedule-id refresh-blizzard-leaderboards
TimeoutStartSec=75min
TimeoutStopSec=1min
