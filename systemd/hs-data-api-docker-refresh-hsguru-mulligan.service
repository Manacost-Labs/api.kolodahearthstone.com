[Unit]
Description=Refresh HSGuru mulligan and class matchups of archetypes and decks in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.cli refresh-hsguru-mulligan --scheduled --schedule-id refresh-hsguru-mulligan
TimeoutStartSec=75min
TimeoutStopSec=1min
