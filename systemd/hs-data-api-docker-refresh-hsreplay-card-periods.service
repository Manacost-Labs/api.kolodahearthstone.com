[Unit]
Description=Refresh HSReplay Legend card statistics periods in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.cli refresh --scheduled --require-all-ok --source hsreplay_cards_legend_1d --source hsreplay_cards_legend_3d --source hsreplay_cards_legend_7d --source hsreplay_cards_legend_14d --source hsreplay_cards_legend_patch --source hsreplay_cards_diamond_4_1_1d --source hsreplay_cards_diamond_4_1_3d --source hsreplay_cards_diamond_4_1_7d --source hsreplay_cards_diamond_4_1_14d --source hsreplay_cards_diamond_4_1_patch --source hsreplay_cards_diamond_1d --source hsreplay_cards_diamond_3d --source hsreplay_cards_diamond_7d --source hsreplay_cards_diamond_14d --source hsreplay_cards_diamond_patch --source hsreplay_cards_platinum_1d --source hsreplay_cards_platinum_3d --source hsreplay_cards_platinum_7d --source hsreplay_cards_platinum_14d --source hsreplay_cards_platinum_patch --source hsreplay_cards_wild_legend_1d --source hsreplay_cards_wild_legend_3d --source hsreplay_cards_wild_legend_7d --source hsreplay_cards_wild_legend_14d --source hsreplay_cards_wild_legend_patch --source hsreplay_cards_wild_diamond_4_1_1d --source hsreplay_cards_wild_diamond_4_1_3d --source hsreplay_cards_wild_diamond_4_1_7d --source hsreplay_cards_wild_diamond_4_1_14d --source hsreplay_cards_wild_diamond_4_1_patch --source hsreplay_cards_wild_diamond_1d --source hsreplay_cards_wild_diamond_3d --source hsreplay_cards_wild_diamond_7d --source hsreplay_cards_wild_diamond_14d --source hsreplay_cards_wild_diamond_patch --source hsreplay_cards_wild_platinum_1d --source hsreplay_cards_wild_platinum_3d --source hsreplay_cards_wild_platinum_7d --source hsreplay_cards_wild_platinum_14d --source hsreplay_cards_wild_platinum_patch
