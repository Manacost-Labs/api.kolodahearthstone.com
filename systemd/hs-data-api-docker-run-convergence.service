[Unit]
Description=Run one bounded Hearthstone freshness convergence attempt
Requires=hs-data-api-docker.service
Wants=hs-data-api-docker-plan-convergence.service
After=hs-data-api-docker.service hs-data-api-docker-plan-convergence.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/hs-data-api
# Runs inside the running API container: a `docker run` per job created and
# removed veth interfaces in three networks every few minutes, which headless
# Chrome on this host reports as net::ERR_NETWORK_CHANGED (#163). `timeout`
# bounds the job inside the container, a stale or stopped one is terminated
# there, and a deploy recreates the container and ends it with it.
ExecStartPre=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 24m python -m app.convergence_worker"
ExecStart=/usr/bin/docker exec hs-data-api timeout --kill-after=30s 24m python -m app.convergence_worker
ExecStopPost=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 24m python -m app.convergence_worker"
TimeoutStartSec=25min
