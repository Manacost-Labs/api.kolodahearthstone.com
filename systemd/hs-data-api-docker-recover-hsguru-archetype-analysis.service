[Unit]
Description=Recover an incomplete HSGuru archetype analysis checkpoint in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.cli refresh-hsguru-archetype-analysis --scheduled --recover-checkpoint --concurrency 2
TimeoutStartSec=30min
TimeoutStopSec=1min

