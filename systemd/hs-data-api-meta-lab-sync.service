[Unit]
Description=Import published HSGuru data and recompute Meta Lab signals (no network)
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker exec hs-data-api python -m app.meta_intelligence sync
TimeoutStartSec=10min
