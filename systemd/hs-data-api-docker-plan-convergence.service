[Unit]
Description=Plan Hearthstone freshness convergence in shadow mode
Requires=hs-data-api-docker.service
Wants=hs-data-api-docker-reconcile-schedule-ledger.service
After=hs-data-api-docker.service hs-data-api-docker-reconcile-schedule-ledger.service

[Service]
Type=oneshot
WorkingDirectory=/srv/hs-data-api
# Runs inside the running API container: a `docker run` per job created and
# removed veth interfaces in three networks every few minutes, which headless
# Chrome on this host reports as net::ERR_NETWORK_CHANGED (#163). `timeout`
# bounds the job inside the container, a stale or stopped one is terminated
# there, and a deploy recreates the container and ends it with it.
ExecStartPre=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 4m python -m app.convergence_planner --mode shadow"
ExecStart=/usr/bin/docker exec hs-data-api timeout --kill-after=30s 4m python -m app.convergence_planner --mode shadow
ExecStopPost=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 4m python -m app.convergence_planner --mode shadow"
TimeoutStartSec=5min
