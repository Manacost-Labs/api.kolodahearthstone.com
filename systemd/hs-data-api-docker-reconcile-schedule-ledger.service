[Unit]
Description=Materialize durable Hearthstone parser schedule obligations
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/hs-data-api
# Runs inside the running API container: a `docker run` per job created and
# removed veth interfaces in three networks every few minutes, which headless
# Chrome on this host reports as net::ERR_NETWORK_CHANGED (#163). `timeout`
# bounds the job inside the container, a stale or stopped one is terminated
# there, and a deploy recreates the container and ends it with it.
ExecStartPre=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 4m python -m app.cli reconcile-schedule-ledger --horizon-hours 48"
ExecStart=/usr/bin/docker exec hs-data-api timeout --kill-after=30s 4m python -m app.cli reconcile-schedule-ledger --horizon-hours 48
ExecStopPost=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 4m python -m app.cli reconcile-schedule-ledger --horizon-hours 48"
TimeoutStartSec=5min
