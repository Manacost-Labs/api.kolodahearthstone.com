[Unit]
Description=Build the Hearthstone nerf/buff Balance Radar (statistics, Reddit, X, Claude)
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target hs-data-api-docker-refresh-hsguru-meta-matrix.service

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm api python -m app.balance_radar run
TimeoutStartSec=45min
TimeoutStopSec=30s
