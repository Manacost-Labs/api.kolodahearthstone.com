[Unit]
Description=Refresh HSGuru Legend archetype analysis in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=2

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
# `docker compose run` outlives a stopped or timed-out unit; the container is
# named after the unit so stale ones are removed before start and after stop.
ExecStartPre=-/usr/bin/docker rm -f %N
ExecStart=/usr/bin/docker compose -f /srv/hs-data-api/docker-compose.yml run --rm --name %N api python -m app.cli refresh-hsguru-archetype-analysis --scheduled --concurrency 4 --schedule-id refresh-hsguru-archetype-analysis
ExecStopPost=-/usr/bin/docker stop --time 20 %N
ExecStopPost=-/usr/bin/docker rm -f %N
TimeoutStartSec=2h
TimeoutStopSec=1min
Restart=on-failure
RestartSec=20min
RestartPreventExitStatus=10
