[Unit]
Description=Refresh HSGuru streamers (live now, streamer decks, Twitch profiles) in Docker
Requires=hs-data-api-docker.service
After=hs-data-api-docker.service network-online.target

[Service]
Type=oneshot
SuccessExitStatus=10
WorkingDirectory=/srv/hs-data-api
# Runs inside the running API container: a `docker run` per job created and
# removed veth interfaces in three networks every few minutes, which headless
# Chrome on this host reports as net::ERR_NETWORK_CHANGED (#163). `timeout`
# bounds the job inside the container, a stale or stopped one is terminated
# there, and a deploy recreates the container and ends it with it.
ExecStartPre=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 34m python -m app.cli refresh-hsguru-streamers"
ExecStart=/usr/bin/docker exec hs-data-api timeout --kill-after=30s 34m python -m app.cli refresh-hsguru-streamers --scheduled --schedule-id refresh-hsguru-streamers
ExecStopPost=-/usr/bin/docker exec hs-data-api pkill -TERM -f "^timeout --kill-after=30s 34m python -m app.cli refresh-hsguru-streamers"
# A steady run reads two or three pages; the first one walks 120 days of
# /streamer-decks (~300 pages, five at a time) and stops taking pages after
# HS_HSGURU_STREAMERS_DEADLINE_SECONDS (25 min).
TimeoutStartSec=35min
TimeoutStopSec=1min
