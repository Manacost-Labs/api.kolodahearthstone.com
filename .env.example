# API
HS_API_DATA_DIR=/var/lib/hs-data-api
HS_API_BIND_HOST=127.0.0.1
HS_API_PORT=8000
HS_API_KEY=change-me
HS_ORCHESTRATOR_API_KEY=
HS_CORS_ALLOWED_ORIGINS=https://api.hs-manacost.ru
HS_API_REQUEST_DELAY_SECONDS=8.0
HS_API_REQUEST_TIMEOUT_SECONDS=150.0

# Refresh parallelism
HS_REFRESH_PARALLEL_LIGHT=3
HS_REFRESH_PARALLEL_MEDIUM=2
HS_REFRESH_PARALLEL_STAGGER_MIN=0.5
HS_REFRESH_PARALLEL_STAGGER_MAX=1.5
HS_REFRESH_DELAY_BROWSER_ONLY=true
HS_REFRESH_PREFLIGHT_STRICT=true
HS_REFRESH_PREFLIGHT_PROBE_HSREPLAY=true
HS_STALE_HOURS=12

# HSReplay channels
HS_HSREPLAY_JSON_CHANNELS=flaresolverr,scrape_do,curl_cffi
HS_HSREPLAY_MARKDOWN_CHANNELS=flaresolverr,curl_cffi
HS_API_JSON_ATTEMPTS_PER_CHANNEL=2
HS_API_JSON_RETRY_DELAY_SECONDS=2.0
# Refresh-scoped guardrails for non-rendered HSReplay JSON fallbacks.
HS_HSREPLAY_SCRAPE_DO_MAX_REQUESTS=120
HS_HSREPLAY_SCRAPE_DO_MAX_CREDITS=160
HS_HSREPLAY_SCRAPE_DO_MAX_CONCURRENCY=2

# Observability and data integrity
HS_TELEGRAM_ALERT_DEDUP_SECONDS=3600
HS_LOG_ROTATE_MAX_BYTES=52428800
HS_LOG_ROTATE_MAX_AGE_DAYS=7
HS_DATASET_REGRESSION_DROP_RATIO=0.30

# Optional semantic review. Deterministic validation remains authoritative.
# Start with observe; quarantine only after measured shadow-mode accuracy.
HS_OPENROUTER_API_KEY=
HS_AI_REVIEW_ENABLED=false
HS_AI_REVIEW_MODE=observe
HS_AI_REVIEW_MODEL=google/gemma-4-26b-a4b-it
# Required when enabled. Use exact IDs; '*' is the explicit all-sources opt-in.
HS_AI_REVIEW_SOURCE_IDS=
HS_AI_REVIEW_TIMEOUT_SECONDS=15
HS_AI_REVIEW_MAX_TOKENS=320
HS_AI_REVIEW_MAX_PROMPT_CHARS=12000
HS_AI_REVIEW_CONFIDENCE_THRESHOLD=0.95
HS_AI_REVIEW_CANDIDATE_MAX_CONCURRENCY=1
HS_AI_REVIEW_DIAGNOSIS_MAX_CONCURRENCY=2
HS_AI_REVIEW_MAX_PER_REFRESH=10
HS_AI_REVIEW_DIAGNOSE_FAILURES=true
HS_AI_REVIEW_MAX_FAILURES_PER_REFRESH=20
HS_AI_REVIEW_RETRY_ATTEMPTS=2
HS_AI_REVIEW_RETRY_BASE_SECONDS=0.25
HS_AI_REVIEW_CIRCUIT_FAILURE_THRESHOLD=3
HS_AI_REVIEW_POST_REFRESH_TIMEOUT_SECONDS=30

# Firecrawl fallback/updaters
# Prefer a rotated key here; never commit real Firecrawl keys to git.
FIRECRAWL_API_KEY=
# Pool format: label|fc-key|credit_limit (comma-separated). Default limit = HS_FIRECRAWL_KEY_ROTATION_CREDITS.
# Example: acct1@example.com|fc-aaa|1000,acct2@example.com|fc-bbb|5000
HS_FIRECRAWL_API_KEYS=
HS_FIRECRAWL_KEY_ROTATION_CREDITS=1000
HS_FIRECRAWL_KEY_RESET_DAY=22
HS_FIRECRAWL_MAX_AGE_MS=172800000
HS_FIRECRAWL_WAIT_MS=5000
HS_FIRECRAWL_TIMEOUT_MS=30000
HS_FIRECRAWL_STREAMER_DECK_LIMIT=200
HS_FIRECRAWL_PRIMARY_SOURCE_IDS=hsguru_streamer_decks_legend_1000
HS_FIRECRAWL_FALLBACK_SOURCE_IDS=hsguru_meta_standard_legend,hsguru_meta_standard_diamond_4to1,hsguru_meta_wild_legend,hsguru_meta_wild_diamond_4to1,hsguru_meta_standard_top_5k,hsguru_meta_standard_top_legend,hsguru_meta_wild_top_legend,hsguru_meta_wild_top_5k,hsguru_matchups_legend,hsguru_matchups_diamond_4to1,hsreplay_battlegrounds_comps,hsreplay_battlegrounds_heroes,hsreplay_battlegrounds_trinkets_lesser,hsreplay_battlegrounds_trinkets_greater,hsreplay_decks_trending,heartharena_tierlist,vicious_syndicate_radars
HS_FIRECRAWL_FALLBACK_MAX_ATTEMPTS_PER_REFRESH=8
HS_FIRECRAWL_FALLBACK_MAX_ATTEMPTS_PER_SOURCE=2

# Shared cloud provider order: Scrape.do, Firecrawl, Bright Data, then Scrapfly.
HS_SCRAPE_DO_TOKEN=
HS_SCRAPE_DO_TIMEOUT_SECONDS=120

# Final fallback Scrapfly pool. Quote this comma-separated value in Docker.
# Format: label|scp-live-key|credit_limit
SCRAPFLY_API_KEY=
HS_SCRAPFLY_API_KEYS=
HS_SCRAPFLY_KEY_ROTATION_CREDITS=1000
HS_SCRAPFLY_KEY_RESET_DAY=22
HS_SCRAPFLY_TIMEOUT_SECONDS=180

# Paid third fallback, before Scrapfly. It remains disabled unless every gate
# is explicit:
# enabled=true, API key, dedicated Web Unlocker zone, exact source-id allowlist,
# limit > 0, and a usage ledger initialized from the provider dashboard.
HS_BRIGHTDATA_UNLOCKER_ENABLED=false
HS_BRIGHTDATA_API_KEY=
HS_BRIGHTDATA_UNLOCKER_ZONE=
HS_BRIGHTDATA_SOURCE_IDS=
HS_BRIGHTDATA_MONTHLY_BILLABLE_LIMIT=0
HS_BRIGHTDATA_TIMEOUT_SECONDS=180
HS_BRIGHTDATA_CIRCUIT_FAILURE_THRESHOLD=3
HS_BRIGHTDATA_CIRCUIT_COOLDOWN_SECONDS=1800
HS_HSGURU_PATCH_PERIOD=auto

# Fun / off-meta deck detector
HS_FUN_DECK_MIN_SCORE=0.55
HS_FUN_DECK_MAX_META_SIMILARITY=0.42
HS_FUN_DECK_RETENTION_HOURS=168

# Scraping proxy
HS_FETCH_REQUIRE_PROXY=true
HS_FETCH_DIRECT_ENABLED=false
HS_FETCH_PROXY_URL=http://USER:PASS@geo.iproyal.com:12321
HS_PROXY_STICKY_MODE=domain
HS_IPROYAL_SESSION_LIFETIME=30m
HS_HTTP_RETRY_ATTEMPTS=3
HS_PROXY_CHECK_URL=https://api.ipify.org

# Browser/backends
HS_FETCH_BACKENDS=flaresolverr,patchright,scrapling,curl_cffi,cloudscraper
HS_HSGURU_FETCH_BACKENDS=flaresolverr,patchright,scrapling,curl_cffi,cloudscraper
HS_FETCH_BACKENDS_LAB=cloakbrowser,flaresolverr,scrapling,patchright,curl_cffi,cloudscraper
HS_FETCH_MAX_RETRIES=3
HS_FETCH_BACKEND_MAX_SECONDS=240
HS_BROWSER_PREFERRED_STICKY_BACKENDS=flaresolverr,patchright,playwright
HS_FLARESOLVERR_URL=http://127.0.0.1:8191/v1
HS_FLARESOLVERR_SESSION_PER_SOURCE=true
HS_FLARESOLVERR_HSGURU_WAIT_MS=12000
HS_FLARESOLVERR_HSGURU_DECKS_WAIT_MS=0
HS_IPROYAL_SESSION_PER_SOURCE=false
HS_IPROYAL_ROTATE_PER_FETCH=false

# Experimental browser stack
HS_FINGERPRINT_SUITE_ENABLED=true
HS_CLOAKBROWSER_HUMANIZE=true
HS_CLOAKBROWSER_GEOIP=true
HS_CLOAKBROWSER_HEADLESS=false
HS_CLOAKBROWSER_HSGURU_HEADLESS=false
HS_CLOAKBROWSER_DISPLAY=:99
HS_SCRAPLING_SOLVE_CLOUDFLARE=true
HS_SCRAPLING_DISABLE_RESOURCES=true
HS_SCRAPLING_TIMEOUT_MS=180000

# HSReplay Premium (optional)
HSREPLAY_EMAIL=
HSREPLAY_PASSWORD=
HSREPLAY_STORAGE_PATH=/var/lib/hs-data-api/hsreplay-auth.json
VICIOUS_SYNDICATE_STORAGE_PATH=/var/lib/hs-data-api/vicious-syndicate-auth.json

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
