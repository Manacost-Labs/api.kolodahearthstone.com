{
  "name": "hs-data-panel-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4180",
    "build": "next build",
    "start": "HOSTNAME=127.0.0.1 PORT=4180 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:http",
    "prebuild": "node scripts/sync-models.mjs",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "test:http": "node tests/integration.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
