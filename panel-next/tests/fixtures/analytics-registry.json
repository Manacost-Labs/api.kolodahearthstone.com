      "params": {
        "provider": {
          "type": "enum",
          "values": ["all", "decodo", "scrape_do", "firecrawl", "scrapfly"],
          "default": "all"
        },
        "days": {
          "type": "enum",
          "values": ["7", "30"],
          "default": "30"
        },
        "source_id": {
          "type": "token",
          "max": 160
        }
      }
    },
    "meta": {
      "title": "Мета Standard / Wild",
      "description": "Архетипы HSGuru: винрейт, популярность, число игр и скорость подъёма.",
      "params": {
        "format": {
          "type": "enum",
          "values": ["standard", "wild"],
          "default": "standard"
        },
        "rank": {
          "type": "enum",
          "values": [
            "all",
            "diamond",
            "diamond_4to1",
            "diamond_to_legend",
            "legend",
            "top_5k",
            "top_legend",
            "top_500",
            "top_100"
          ],
          "default": "legend"
        },
        "period": {
          "type": "token",
          "default": "past_day",
          "max": 64
        },
        "min_games": {
          "type": "int",
          "default": 100,
          "min": 0,
          "max": 1000000
        }
      }
    },
