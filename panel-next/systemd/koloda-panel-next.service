[Unit]
Description=HS Data Next.js admin panel
After=network.target php-fpm74.service

[Service]
Type=simple
User=koloda
Group=koloda
WorkingDirectory=/srv/api-kolodahearthstone/panel-next/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4181
Environment=PANEL_BACKEND_ORIGIN=http://127.0.0.1:18769
Environment=PANEL_PUBLIC_ORIGIN=https://api.kolodahearthstone.com
ExecStart=/usr/bin/node /srv/api-kolodahearthstone/panel-next/current/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0027

[Install]
WantedBy=multi-user.target
