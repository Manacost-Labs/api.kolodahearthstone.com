[Unit]
Description=Download localized HearthstoneJSON card renders (WebP)
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=koloda
Group=koloda
WorkingDirectory=/srv/api-kolodahearthstone/panel/current
# Deliberately takes no shared sync locks: a run lasts up to ~35 min.
ExecStart=/opt/wiki-hs-parser/.venv/bin/python scripts/sync_card_renders.py --apply
SuccessExitStatus=75
TimeoutStartSec=50min
Nice=10
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/api-kolodahearthstone/panel-data/uploads /srv/api-kolodahearthstone/panel-data/var
